<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      table {
        border: 1px solid black;
      }
    </style>
  </head>
  <body>
    <h1>Home Page</h1>
    <div>
    <table border="1">
      <thead>
      <tr>
        <td>Page Name</td>
        <td>Page Link</td>
      </tr>
      </thead>
      
            <%result.forEach((page)=> {%>
              <tbody>
              <tr>
        <td><%=page.name%></td>
        <td><a href="<%= page.link%>"><%= page.link%></a></td>
        </tr>
        </tbody>
      <%}) %>        
    </table>
      
    </div>


  </body>
</html>
