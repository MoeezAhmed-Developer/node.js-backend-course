<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/updated/<%= result._id %>" method="post">
      <input type="text" value="<%= result.name%>" /> <br />
      <input type="text" value="<%= result.age%>" /> <br />
      <input type="text" value="<%= result.city%>" /><br />
      <input type="text" value="<%= result.profession%>" /> <br />
      <input type="text" value="<%= result.isActive%>" /> <br />
      <button>Update Student</button>
    </form>
  </body>
</html>
