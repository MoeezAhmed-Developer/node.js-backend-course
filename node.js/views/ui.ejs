<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            font-family: "poppins";
        }

        li {
            list-style-type: none;
        }
    </style>
</head>

<body>
    <h1>Data will be here</h1>
    <table border="1">
        <thead>
            <tr>
                <td>S.No</td>
                <td>Name</td>
                <td>Age</td>
                <td>Email</td>
                <td>Operation</td>
            </tr>
        </thead>
        <tbody>
            <% users.forEach((user,idx)=> {%>

                <tr>
                    <td>

                        <li>
                            <%= idx%>
                        </li>

                    </td>
                    <td>
                        <%= user.name%>
                    </td>
                    <td>
                        <%= user.age%>
                    </td>
                    <td>
                        <%= user.email%>
                    </td>

                    <td>
                        <a href="/user/delete/<%= user._id%>">Delete</a>
                    </td>
                </tr>

                <% })%>
        </tbody>
    </table>
</body>

</html>